{
  "manifest_version": 3,
  "name": "AutoTax V1.1 - Quản lý hóa đơn",
  "short_name": "AutoTax",
  "version": "1.1.0",
  "description": "AutoTax V1.1: tải hóa đơn gốc theo link và mã tra cứu, dựng bản PDF từ dữ liệu Thuế khi thiếu thông tin.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "downloads",
    "storage",
    "permissions"
  ],
  "host_permissions": [
    "https://hoadondientu.gdt.gov.vn/*",
    "https://ucqqjdsoyvvaxswzbhaw.supabase.co/*",
    "https://meinvoice.vn/*",
    "https://*.meinvoice.vn/*",
    "https://fpt.com.vn/*",
    "https://*.fpt.com.vn/*",
    "https://kiotviet.vn/*",
    "https://*.kiotviet.vn/*",
    "https://vnpt-invoice.com.vn/*",
    "https://*.vnpt-invoice.com.vn/*",
    "https://ehoadon.vn/*",
    "https://*.ehoadon.vn/*",
    "https://easyinvoice.vn/*",
    "https://*.easyinvoice.vn/*",
    "https://minvoice.com.vn/*",
    "https://*.minvoice.com.vn/*",
    "https://thaison.vn/*",
    "https://*.thaison.vn/*",
    "https://mobifone.vn/*",
    "https://*.mobifone.vn/*",
    "https://fast.com.vn/*",
    "https://*.fast.com.vn/*",
    "https://nacencomm.vn/*",
    "https://*.nacencomm.vn/*",
    "https://hilo.com.vn/*",
    "https://*.hilo.com.vn/*",
    "https://matbao.in/*",
    "https://*.matbao.in/*",
    "https://vinvoice.vn/*",
    "https://*.vinvoice.vn/*",
    "https://viettel.vn/*",
    "https://*.viettel.vn/*",
    "https://smartsign.com.vn/*",
    "https://*.smartsign.com.vn/*",
    "https://xuathoadon.vn/*",
    "https://*.xuathoadon.vn/*",
    "https://cloudinvoice.vn/*",
    "https://*.cloudinvoice.vn/*",
    "https://vietinvoice.vn/*",
    "https://*.vietinvoice.vn/*",
    "https://oinvoice.vn/*",
    "https://*.oinvoice.vn/*",
    "https://ehoadon.online/*",
    "https://*.ehoadon.online/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "AutoTax - Công cụ tải HĐĐT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/fonts/*.ttf"
      ],
      "matches": [
        "https://hoadondientu.gdt.gov.vn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hoadondientu.gdt.gov.vn/*"
      ],
      "js": [
        "src/content/zip.js",
        "src/content/xlsx.js",
        "src/content/tendoo-import.js",
        "src/content/captcha-svg-templates.js",
        "src/content/captcha-svg.js",
        "src/content/issuer-portals.js",
        "src/content/hddt-api.js",
        "src/content/report.js",
        "src/content/pdf.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.1"
}
