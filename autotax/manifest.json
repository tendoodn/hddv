{
  "manifest_version": 3,
  "name": "AutoTax - Công cụ tải HĐĐT",
  "short_name": "AutoTax",
  "version": "3.3.6",
  "description": "AutoTax - Công cụ hỗ trợ tra cứu và tải hóa đơn điện tử.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://hoadondientu.gdt.gov.vn/*",
    "https://ucqqjdsoyvvaxswzbhaw.supabase.co/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "AutoTax - Công cụ tải HĐĐT",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/fonts/*.ttf"
      ],
      "matches": [
        "https://hoadondientu.gdt.gov.vn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://hoadondientu.gdt.gov.vn/*"
      ],
      "js": [
        "src/content/zip.js",
        "src/content/xlsx.js",
        "src/content/tendoo-import.js",
        "src/content/captcha-svg-templates.js",
        "src/content/captcha-svg.js",
        "src/content/hddt-api.js",
        "src/content/report.js",
        "src/content/pdf.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
